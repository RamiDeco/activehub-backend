# Copiá este archivo como `.env` y completá los valores. `.env` está en .gitignore
# a propósito: lleva la contraseña de la base y NO va al repositorio.
#
# Spring lo carga desde application.yml con
#   spring.config.import: optional:file:./.env[.properties]
# así que el formato es properties (clave=valor), no shell: sin `export`, sin comillas.

# --- Base de datos ---------------------------------------------------------
# Cadena de conexión de Supabase (Connection Pooling → URI, en modo Session).
DATABASE_URL=jdbc:postgresql://<host>.pooler.supabase.com:5432/postgres
DATABASE_USERNAME=postgres.<referencia-del-proyecto>
DATABASE_PASSWORD=<contraseña-de-la-base>

# --- Firma de los JWT ------------------------------------------------------
# Mínimo 32 caracteres. Generá uno propio: no uses el default de application.yml
# fuera de tu máquina, porque con él cualquiera puede firmar un token válido.
JWT_SECRET=<cadena-larga-y-aleatoria>

# --- Opcionales ------------------------------------------------------------
# Minutos de inactividad antes de que venza la sesión (default 30).
#JWT_EXPIRATION_MIN=30

# Orígenes permitidos por CORS (default http://localhost:5173, el dev server de Vite).
#CORS_ALLOWED_ORIGINS=http://localhost:5173

# Crea una cuenta de administrador en el arranque si no existe ninguna.
#ADMIN_SEED_EMAIL=
#ADMIN_SEED_PASSWORD=
