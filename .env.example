# Variables de entorno del backend de ActiveHub. Copiar a `.env` y completar.
# Este archivo se versiona: NUNCA poner valores reales acá (ver .gitignore).
# Las que tienen valor son defaults que no son secretos; las vacías son obligatorias
# u opcionales según el comentario.

# --- Base de datos (obligatorias) -------------------------------------------------
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DB_POOL_SIZE=5

# --- Servidor y seguridad -----------------------------------------------------------
PORT=8080
# Secreto de firma de los JWT (obligatorio fuera de desarrollo; largo y aleatorio).
JWT_SECRET=
# Vigencia del token = ventana de inactividad de la sesión (E1A-HU02 crit. 3).
JWT_EXPIRATION_MIN=30
CORS_ALLOWED_ORIGINS=http://localhost:5173
# A dónde vuelve el navegador después de un flujo externo (callback de OAuth de Mercado Pago).
FRONTEND_URL=http://localhost:5173

# Admin inicial: si se completan las dos, al arrancar se crea esa cuenta ADMIN (si no existe).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# --- Correo (Gmail SMTP con contraseña de aplicación) -------------------------------
# Sin MAIL_USERNAME el backend escribe los mails en el log en vez de mandarlos.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NOMBRE=ActiveHub
VERIFICACION_TTL_MIN=15
VERIFICACION_ESPERA_REENVIO_SEG=60
VERIFICACION_MAX_INTENTOS=5

# --- Google Identity Services ---------------------------------------------------------
# Vacío = "Continuar con Google" deshabilitado.
GOOGLE_CLIENT_ID=

# --- Archivos subidos -------------------------------------------------------------------
# Con las dos de Supabase completas se usa Supabase Storage; si falta alguna, disco local.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=activehub
FOTOS_PERFIL_DIR=./uploads/fotos-perfil
FOTOS_ACTIVIDAD_DIR=./uploads/fotos-actividad
DOCUMENTOS_INSTRUCTOR_DIR=./uploads/documentos-instructor

# --- IA (Groq Cloud) ------------------------------------------------------------------
# Vacía = el asistente y el informe responden 503 y el frontend cae a su modo sin IA.
GROQ_API_KEY=
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODELO=openai/gpt-oss-120b
# Vaciar si se cambia a un modelo que no razona.
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SEG=25

# --- Mercado Pago (marketplace: cada instructor cobra con su propia cuenta) -----------
# OAuth de la aplicación de MP: con esto el instructor vincula su cuenta.
# En sandbox, la aplicación tiene que ser de un usuario de prueba "Integrador".
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Tiene que coincidir EXACTO con la URL de redireccionamiento configurada en la aplicación.
# Ej.: http://localhost:8080/api/instructor/mercadopago/callback
MP_REDIRECT_URI=
# AES-256 (32 bytes en base64) para cifrar en la base los tokens de los instructores.
# Si se cambia, los tokens guardados ya no se pueden leer y hay que volver a vincular.
MP_TOKEN_ENCRYPTION_KEY=
# Clave secreta del webhook (panel de la aplicación > Webhooks). Vacía = toda notificación se rechaza.
MP_WEBHOOK_SECRET=
# Solo sandbox: correo del comprador de prueba (@testuser.com). En producción, vacía.
MP_SANDBOX_PAYER_EMAIL=
# DEBUG = loguea cada pedido y respuesta de MP con los secretos recortados.
MP_LOG_LEVEL=INFO
# No la usa ningún código hoy (cada cobro va con el token del instructor); se conserva por compatibilidad.
MP_ACCESS_TOKEN=
# Nombres anteriores de MP_CLIENT_ID y MP_REDIRECT_URI, aceptados como respaldo:
# APP_ID=
# REDIRECT_URI=
